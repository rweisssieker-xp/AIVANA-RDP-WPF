<Window x:Class="Aivana_RDP_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aivana_RDP_WPF"
        xmlns:vm="clr-namespace:Aivana_RDP_WPF.ViewModels"
        xmlns:cm="clr-namespace:Aivana_RDP_WPF.ViewModels.ConnectionManagement"
        xmlns:views="clr-namespace:Aivana_RDP_WPF.Views.ConnectionManagement"
        xmlns:analyticsViews="clr-namespace:Aivana_RDP_WPF.Views.Analytics"
        xmlns:aiViews="clr-namespace:Aivana_RDP_WPF.Views.AI"
        xmlns:settingsViews="clr-namespace:Aivana_RDP_WPF.Views"
        xmlns:historyViews="clr-namespace:Aivana_RDP_WPF.Views.History"
        xmlns:healthViews="clr-namespace:Aivana_RDP_WPF.Views.Health"
        xmlns:reportsViews="clr-namespace:Aivana_RDP_WPF.Views.Reports"
        mc:Ignorable="d"
        Title="Aivana RDP Client" Height="768" Width="1024"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#0078D4" Padding="16,12">
                    <TextBlock Text="Aivana RDP" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                </Border>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1" Margin="8,8,8,4">
                    <Button Content="Connections" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowConnectionListCommand}"/>
                    <Button Content="Analytics" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowAnalyticsCommand}"/>
                    <Button Content="AI Assistant" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowAIAssistantCommand}"/>
                    <Button Content="Reports" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowReportsCommand}"/>
                    <Button Content="Health" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowHealthCommand}"/>
                    <Button Content="History" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowHistoryCommand}"/>
                    <Button Content="Settings" Padding="12,8" Margin="0,0,0,6"
                            Command="{Binding ShowSettingsCommand}"/>
                </StackPanel>

                <!-- Connection List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ConnectionListViewModel.Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" Margin="8,4" Padding="12" 
                                        BorderBrush="#E1E1E1" BorderThickness="1" 
                                        CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonDown="ConnectionItem_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding ServerAddress}" Foreground="#6B6B6B" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Port, StringFormat='Port: {0}'}" Foreground="#6B6B6B" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Connect" Padding="8,4" Margin="8,0,0,0"
                                                Click="ConnectButton_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="White">
            <ContentControl Content="{Binding CurrentContent}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type cm:ConnectionListViewModel}">
                        <views:ConnectionListView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type cm:ConnectionSessionViewModel}">
                        <views:ConnectionSessionView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
                        <analyticsViews:AnalyticsDashboardView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AIAssistantViewModel}">
                        <aiViews:AIAssistantDashboardView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <settingsViews:SettingsView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <historyViews:HistoryView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HealthOverviewViewModel}">
                        <healthViews:HealthOverviewView DataContext="{Binding}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                        <reportsViews:ReportsView DataContext="{Binding}"/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>