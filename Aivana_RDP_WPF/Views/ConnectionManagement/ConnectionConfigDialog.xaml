<Window x:Class="Aivana_RDP_WPF.Views.ConnectionManagement.ConnectionConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aivana_RDP_WPF.Views.ConnectionManagement"
        xmlns:converters="clr-namespace:Aivana_RDP_WPF.Converters"
        mc:Ignorable="d"
        Title="Connection Configuration" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:ColorDepthToIndexConverter x:Key="ColorDepthToIndexConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Information -->
                <GroupBox Header="Basic Information" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Connection Name *" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Name}" Height="32"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Server Address *" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ServerAddress}" Height="32"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Port *" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Port}" Height="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Default: 3389" Foreground="#6B6B6B" FontSize="11" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Credentials -->
                <GroupBox Header="Credentials" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Username" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Username}" Height="32"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Password" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PasswordBox" Height="32" PasswordChanged="PasswordBox_PasswordChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Domain (optional)" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Domain}" Height="32"/>
                        </StackPanel>
                        <CheckBox Content="Save password" Margin="0,12,0,0" IsChecked="{Binding SavePassword}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Display Settings -->
                <GroupBox Header="Display Settings" Padding="12">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Resolution" Margin="0,0,0,4"/>
                            <ComboBox SelectedItem="{Binding Resolution}" Height="32">
                                <ComboBoxItem Content="1920x1080"/>
                                <ComboBoxItem Content="1680x1050"/>
                                <ComboBoxItem Content="1600x900"/>
                                <ComboBoxItem Content="1280x720"/>
                                <ComboBoxItem Content="Full Screen"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="Color Depth" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding ColorDepth, Converter={StaticResource ColorDepthToIndexConverter}}" Height="32">
                                <ComboBoxItem Content="16-bit"/>
                                <ComboBoxItem Content="24-bit"/>
                                <ComboBoxItem Content="32-bit"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="1" Background="#F3F3F3" Padding="12" Margin="0,16,0,0" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,8" MinWidth="100" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button Content="Save" Padding="16,8" MinWidth="100" Margin="0,0,0,0" 
                        Background="#0078D4" Foreground="White"
                        Command="{Binding SaveCommand}" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

