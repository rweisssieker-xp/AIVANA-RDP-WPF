<UserControl x:Class="Aivana_RDP_WPF.Views.ConnectionManagement.ConnectionSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aivana_RDP_WPF.Views.ConnectionManagement"
             xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:converters="clr-namespace:Aivana_RDP_WPF.Converters"
             xmlns:views="clr-namespace:Aivana_RDP_WPF.Views.ConnectionManagement"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F3F3F3" Padding="12" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Profile.Name}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#6B6B6B" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Connect" Padding="12,6" Margin="0,0,8,0" 
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBooleanConverter}}"/>
                    <Button Content="Disconnect" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsConnected}"/>
                    <Button Content="Full Screen" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding ToggleFullScreenCommand}"
                            IsEnabled="{Binding IsConnected}"/>
                    <Button Content="Health Check" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding RunHealthCheckCommand}"
                            IsEnabled="{Binding IsHealthChecking, Converter={StaticResource InverseBooleanConverter}}"/>
                    <Button Content="Health Metrics" Padding="12,6"
                            Command="{Binding ToggleHealthMetricsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Health Metrics Panel -->
        <Border Grid.Row="1" Background="#F9F9F9" Padding="8" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowHealthMetrics}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Health Check" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Last result:" FontSize="12" Foreground="#6B6B6B"/>
                            <TextBlock Text="{Binding HealthCheckResult.TimestampUtc}" FontSize="12"/>
                            <TextBlock Text="{Binding HealthCheckResult.ResolvedIp, StringFormat='IP: {0}'}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding HealthCheckResult.PingSuccess, StringFormat='Ping: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding HealthCheckResult.PingRoundtripMs, StringFormat='Ping ms: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding HealthCheckResult.PortOpen, StringFormat='Port open: {0}'}" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding HealthCheckResult.TcpConnectMs, StringFormat='TCP ms: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding HealthCheckResult.ErrorMessage}" FontSize="12" Foreground="#B00020" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Session History" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <Border Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="4" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
                            <ItemsControl ItemsSource="{Binding RecentSessionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding ConnectedAt, StringFormat='Start: {0}'}" FontSize="12"/>
                                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="12"/>
                                            <TextBlock Text="{Binding DurationTicks, StringFormat='Ticks: {0}'}" FontSize="11" Foreground="#6B6B6B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <views:ConnectionHealthView Grid.Column="1" DataContext="{Binding HealthViewModel}"/>
            </Grid>
        </Border>

        <!-- RDP Host Container -->
        <Grid Grid.Row="2" Background="Black">
            <ContentControl Content="{Binding RdpHost}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type wf:WindowsFormsHost}">
                        <Border BorderBrush="#404040" BorderThickness="1">
                            <ContentPresenter Content="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
            <TextBlock Text="RDP Session will appear here" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Foreground="White" FontSize="14"
                      Visibility="{Binding RdpHost, Converter={StaticResource NullToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>

