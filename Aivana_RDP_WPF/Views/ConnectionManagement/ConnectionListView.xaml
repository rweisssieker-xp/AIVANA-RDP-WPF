<UserControl x:Class="Aivana_RDP_WPF.Views.ConnectionManagement.ConnectionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aivana_RDP_WPF.Views.ConnectionManagement"
             xmlns:vm="clr-namespace:Aivana_RDP_WPF.ViewModels.ConnectionManagement"
             xmlns:converters="clr-namespace:Aivana_RDP_WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F3F3F3" Padding="12" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="New Connection" Padding="12,6" Margin="0,0,8,0" 
                        Command="{Binding CreateConnectionCommand}"/>
                <Button Content="Refresh" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding LoadConnectionsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Connection List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Connections}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Margin="0,4" Padding="12" 
                                BorderBrush="#E1E1E1" BorderThickness="1" 
                                CornerRadius="4" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding ServerAddress}" Foreground="#6B6B6B" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Port, StringFormat='Port: {0}'}" Foreground="#6B6B6B" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Edit" Margin="4,0" Padding="8,4" 
                                            Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Delete" Margin="4,0" Padding="8,4"
                                            Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <TextBlock Grid.Row="1" Text="No connections found. Click 'New Connection' to create one." 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#6B6B6B" FontSize="14"
                   Visibility="{Binding Connections.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=0}"/>
    </Grid>
</UserControl>

